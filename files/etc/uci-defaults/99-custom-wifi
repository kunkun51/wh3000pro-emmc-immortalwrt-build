#!/bin/sh
. /lib/functions.sh
# 首次启动设置 WiFi（只改 SSID/密码/加密/信道/htmode），其余由官方自动探测生成
# 升级时不覆盖用户已改的配置
[ "$PKG_UPGRADE" = 1 ] && exit 0

# 若官方尚未生成无线配置，则自动探测生成（wifi detect 已在 22.03+ 移除，用 wifi config）
[ -f /etc/config/wireless ] || wifi config 2>/dev/null || wifi detect 2>/dev/null || true

# ---- 接口段：按所属设备的频段分别设置 SSID / 加密 / 密码 / 启用 ----
set_wifi() {
	local iface="$1" dev band hwmode ssid
	config_get dev "$iface" device
	config_get band "$dev" band
	# 部分驱动不写 band，则按 hwmode 判断频段
	if [ -z "$band" ]; then
		config_get hwmode "$dev" hwmode
		case "$hwmode" in
			11a|11ac|11ax|11be) band='5g' ;;
			*) band='2g' ;;
		esac
	fi
	case "$band" in
		5g*) ssid='DIY-CPE-5G' ;;
		*)   ssid='DIY-CPE-2.4G' ;;
	esac
	uci -q set wireless."$iface".ssid="$ssid"
	uci -q set wireless."$iface".encryption='psk-mixed'
	uci -q set wireless."$iface".key='11111111'
	uci -q set wireless."$iface".disabled='0'
}
config_load wireless
config_foreach set_wifi wifi-iface

# ---- 设备段：信道 / htmode（按官方探测到的频段区分，其余 path/type/band/country 由官方生成）----
set_dev() {
	uci -q set wireless."$1".channel='auto'
	local band
	config_get band "$1" band
	case "$band" in
		5g) uci -q set wireless."$1".htmode='HE160' ;;
		*)  uci -q set wireless."$1".htmode='HE40' ;;
	esac
}
config_foreach set_dev wifi-device

uci commit wireless
exit 0
